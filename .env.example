# From https://my.telegram.org — API development tools.
# Never commit real values. Never expose the hash to the browser.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Set to true only when you intend to use Telegram's test servers.
USE_TEST_DC=false

DATABASE_URL=

APP_URL=http://localhost:3000
API_URL=http://localhost:4000

SESSION_SECRET=

# Directory for per-user TDLib databases. Gitignored.
TDLIB_DATA_DIR=.tdlib-data

# Optional base64-encoded database encryption key.
# If empty, the first auth run creates .tdlib-data/encryption-key and reuses it.
# Never commit that file or this value.
TDLIB_ENCRYPTION_KEY=
